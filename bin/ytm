#!/usr/bin/env python3
"""ytm: youtube music, light. mpv plays audio in the background, ytmusicapi finds the songs.

goal: simple to use, runs in the background, light on the machine, with all the features and then some. the electron app idles at ~370 MB; this aims for ~40-60 MB while playing.

  ytm <words>          play the best match now, then a radio of ~25 songs like it. the words are read first:
                       ytm music for coding (a mode) · ytm songs like low roar · ytm arijit singh new · ytm more like this
  ytm play <words>     the same, when the words are also a command (ytm play logout · ytm -- likes); the app always uses this
  ytm play --vid <id>  that exact song, then its radio (the app's search cards use this)
  ytm search <words>   the top 3, numbered · ytm search --json <words>  the same as json, for the app (no player needed)
  ytm pick <words>     choose from the top 3 (fzf)
  ytm add <words>      queue the best match after the current song
  ytm radio            refill the queue with a radio from what's playing (it also refills itself when the queue runs out)
  ytm p | n | b        pause/play · next · back
  ytm np               what's playing (title · time)
  ytm q                the queue
  ytm vol <0-100>      volume · ytm seek <±s>
  ytm work             work mode: chill, no lyrics (lofi, beats, instrumental), picked for you, quieter
  ytm mode [name]      19 modes to say what you're doing: work focus coding design writing reading study cafe · gym run drive cook gaming party ·
                       morning winddown · chill energy sleep. ytm mode new <name> "seed, seed" makes your own (--instrumental --vol N)
  ytm stage            the native stage: a living, song-matched wallpaper with the player on glass
  ytm ui               the clickable player: search, queue, history, work mode
  ytm shuffle · surprise   a new queue order · a mood you didn't pick
  ytm out [x]          the audio outputs (bluetooth, airplay, usb, hdmi): list · pick · auto · reload. it re-opens itself when one comes or goes
  ytm cache [play|clear]  the offline cache (1 GB, fills itself while playing): your queue + most-finished songs, plays when the network is gone
  ytm stop             stop and shut the player down
  ytm update           upgrade yt-dlp, mpv and ytmusicapi now (DATA/update.log); also when a player starts on a 3-day-old stack
  ytm agents install|remove|status   a daily `ytm update` as a launchd agent (low priority), so a player that lives for days stays fresh

the account (0.8; lib/, loaded only by the commands that need it):
  ytm login [src]      youtube music from a signed-in browser: auto · vivaldi[:profile] · chrome · brave · safari · firefox · app
  ytm logout           forget it · ytm auth status [--json]   youtube music + spotify, no network
  ytm like [vid]       thumbs up the song playing (or vid) · ytm dislike [vid] (the playing one also skips) · ytm unrate [vid]
                       kept on this mac too (works signed out): a dislike is never queued again, a like lifts its artist · ytm rated [liked|disliked]
  ytm likes            your liked songs, shuffled · ytm for-you   picks from your home page × what you finish
  ytm mixes            your mixes, numbered · ytm mix [n]   play mix n (default 1)
  ytm history [--backfill]   the account's recent plays; --backfill copies them into the listening log
  ytm spotify <login|logout|status|client-id ID|top|recent|saved|artists|match X>
  ytm taste [--json]   what the log says about you: when you listen, what you finish or skip, how sure it is
  ytm look [name]      the look everywhere (auto · dusk · rain · neon · stars · paper · aurora · ember · tide); auto: the song picks, ytm look says why
                       ytm look accent ember · ytm look motion still
  ytm prefs --json     the shared prefs (DATA/prefs.json) · ytm --version

media keys and the status bar work through macOS now playing (mpv --media-controls).
state: ~/.local/share/ytm (socket, log, prefs). ytmusicapi lives in ~/.local/share/ytm/venv. logged out: search + radio still work.
"""
import json, os, re, socket, subprocess, sys, time
from pathlib import Path

HOME = Path.home()
ROOT = Path(__file__).resolve().parent.parent   # the repo (or install) root: bin/ytm sits one level down, and a symlink to it still resolves here
os.environ.setdefault("YTM_BIN", str(Path(__file__).resolve()))   # mpv inherits it: the listening-log script calls back into this cli
LIB = ROOT / "lib"
VERSION_FILE = ROOT / "VERSION"
sys.path.insert(0, str(LIB))
from looks import LOOKS, LOOK_NAMES, ACCENTS, MOTIONS   # the tables the cli, the terminal ui and the stage share
from modes import MODES, VOCAL_HINTS, MODE_NAME   # the mode table (lib/modes.py)
from analysis import FPS, BANDS, SR, MAX_SECONDS, FAIL_HOLD, analyze_pcm, moments   # the audio maths (lib/analysis.py)
DATA = Path(os.environ.get("YTM_DATA", HOME / ".local/share/ytm"))  # tests point this at a scratch dir, never the real log
VENV_PY = HOME / ".local/share/ytm/venv/bin/python"
SOCK = DATA / "mpv.sock"
LOG = DATA / "mpv.log"

if Path(sys.prefix).resolve() != VENV_PY.parent.parent.resolve() and VENV_PY.exists() and not os.environ.get("YTM_NO_REEXEC"):
    os.execv(str(VENV_PY), [str(VENV_PY), __file__, *sys.argv[1:]])  # ytmusicapi is only in the venv
if not VENV_PY.exists() and not os.environ.get("YTM_NO_REEXEC"):
    try: __import__("ytmusicapi")
    except ImportError: sys.exit("ytm: not set up yet. run ./install.sh from the afterhum folder")

MPV_ARGS = ["--idle=yes", "--ao=avfoundation,coreaudio",   # bluetooth bug: mpv's coreaudio AO froze silently on some headsets (time-pos stood still, "playing", 60 s buffered; ao-reload fixed it and mpv fell to avfoundation, which then held). avfoundation first, coreaudio as the fallback
             "--no-video", "--no-terminal", "--force-window=no", f"--input-ipc-server={SOCK}",
            "--ytdl-format=234/233/bestaudio",  # youtube 403s the dash audio (140/251) without a po token; the hls audio (234/233) streams fine
            "--prefetch-playlist=yes", "--cache=yes", "--cache-secs=120", "--network-timeout=20", "--stream-lavf-o=reconnect=1,reconnect_streamed=1,reconnect_delay_max=5", "--audio-buffer=1",  # 1 s of audio in hand: a busy mac doesn't crackle (default 0.2)
            "--demuxer-max-bytes=16MiB", "--demuxer-max-back-bytes=4MiB",
            f"--media-controls={os.environ.get('YTM_MEDIA_CONTROLS', 'yes')}",   # a scratch test player must never take over now playing
            f"--script={ROOT}/ytm-log.lua", f"--volume={os.environ.get('YTM_VOLUME', '60')}", "--audio-display=no", "--msg-level=all=warn",
            *([f"--log-file={LOG}"] if os.environ.get("YTM_DEBUG") else [])]  # the log file is verbose by design: 1125 ipc lines in 2 min. debug only


def ipc(*cmd, start=True):
    """send one mpv json-ipc command, return its data (None on error)."""
    if start and not SOCK.exists():
        daemon()
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(3); s.connect(str(SOCK))
            s.sendall((json.dumps({"command": list(cmd)}) + "\n").encode())
            buf = b""
            while True:
                chunk = s.recv(65536)
                if not chunk: return None
                buf += chunk
                *lines, buf = buf.split(b"\n")
                for line in lines:
                    r = json.loads(line) if line.strip() else {}
                    if r and "event" not in r:  # mpv interleaves events with the reply
                        return r.get("data") if r.get("error") == "success" else None
    except (ConnectionRefusedError, FileNotFoundError):
        if start:  # only these mean a dead player (stale socket): clear it and start fresh once
            SOCK.unlink(missing_ok=True); daemon()
            return ipc(*cmd, start=False)
        return None
    except (OSError, ValueError):
        return None  # a slow or busy player (timeout) is still alive: never unlink its socket or start a second mpv


UPDATE_EVERY = 3 * 86400  # yt-dlp breaks when youtube changes; fresh every few days keeps it playing
UPDATE_TRY_GAP = 6 * 3600 # an upgrade that failed (or a dead network) waits 6 h before the next go: never a loop
STAMP = Path(os.environ.get("YTM_UPDATE_STAMP") or HOME / ".local/share/ytm/updated")   # one stamp for the machine, whatever YTM_DATA says
TRIED = STAMP.with_name(".update.tried")
UPDATE_LOG = DATA / "update.log"
UPDATE_LOG_CAP = 256 * 1024
REAL_UPDATE = ("HOMEBREW_NO_AUTO_UPDATE= brew upgrade yt-dlp mpv && uv pip install -q -U --python {py} ytmusicapi")


def _update_cmd():
    """the upgrade to run. tests (YTM_DATA) never get the real one: 10-23 every scratch run fired a brew upgrade mid-song"""
    if os.environ.get("YTM_UPDATE_CMD"): return os.environ["YTM_UPDATE_CMD"]
    return None if os.environ.get("YTM_DATA") else REAL_UPDATE.format(py=VENV_PY)


def _age(p):
    try: return time.time() - p.stat().st_mtime
    except OSError: return float("inf")


def _cap_log(f, cap=UPDATE_LOG_CAP):
    """keep the last half when it passes cap. in place, not a rename: launchd may hold the file open for append"""
    try:
        if f.stat().st_size <= cap: return
        with f.open("r+b") as h:
            h.seek(-(cap // 2), 2); tail = h.read(); tail = tail[tail.find(b"\n") + 1:]
            h.seek(0); h.write(tail); h.truncate()
    except OSError: pass


def run_update(why):
    """one upgrade, now, here. locked machine-wide; logged to DATA/update.log; the stamp moves only after it worked
    (10-25 audit: it was touched before, so a failed upgrade still counted as fresh for 3 days). -> True when it worked."""
    import fcntl
    cmd = _update_cmd()
    if not cmd: return print("ytm: scratch data (YTM_DATA): not upgrading the real stack", file=sys.stderr) or False
    DATA.mkdir(parents=True, exist_ok=True); STAMP.parent.mkdir(parents=True, exist_ok=True)
    with (STAMP.parent / ".update.lock").open("w") as lock:
        try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError: return print("ytm: an update is already running", file=sys.stderr) or False
        TRIED.touch()
        _cap_log(UPDATE_LOG)
        with UPDATE_LOG.open("a") as log:
            log.write(f"== {time.strftime('%F %T')} {why}\n"); log.flush()
            try: rc = subprocess.run(["/bin/sh", "-c", cmd], stdout=log, stderr=log, stdin=subprocess.DEVNULL, timeout=900).returncode
            except subprocess.TimeoutExpired: rc = "timeout"
            if rc == 0: STAMP.touch()
            log.write(f"== {time.strftime('%F %T')} {'done' if rc == 0 else f'failed ({rc}); the stamp stays, next try in 6 h'}\n")
        return rc == 0


def update(now=False, broken=False):
    """keep the stack fresh. now: `ytm update`, here and loud. broken: ytm-log.lua saw three songs fail to open, so yt-dlp may
    be stale whatever the stamp says (at most once per 6 h). otherwise (a player starting): a 3-day-old stamp → upgrade in a
    detached child, once per 6 h. the daily launchd agent (ytm agents install) is the clock; this is the backstop."""
    if now:
        print(f"ytm: updating yt-dlp, mpv, ytmusicapi… (log: {UPDATE_LOG})")
        ok = run_update("asked"); print("ytm: up to date" if ok else f"ytm: the update didn't finish; see {UPDATE_LOG}"); return 0 if ok else 1
    if _age(TRIED) < UPDATE_TRY_GAP or not _update_cmd(): return None
    if broken: return 0 if run_update("three songs wouldn't open") else 1
    if _age(STAMP) < UPDATE_EVERY: return None
    subprocess.Popen([sys.executable, __file__, "update", "--auto"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)   # the child holds the lock and writes the log


def update_child():
    """ytm update --auto: the daemon's detached upgrade (the gap is checked again: two players starting at once)"""
    if _age(TRIED) < UPDATE_TRY_GAP or _age(STAMP) < UPDATE_EVERY: return None
    return 0 if run_update("a player started on a 3-day-old stack") else 1


# ---- the clock: a launchd agent that runs `ytm update` daily. written + tested here; installed by hand (ytm agents install)
AGENT = "dev.afterhum.ytm-update"


def agents_dir():
    return Path(os.environ.get("YTM_LAUNCHAGENTS") or HOME / "Library/LaunchAgents")   # tests point this at a scratch dir


def agent_plist():
    """the plist text: daily at 05:15 (launchd runs a missed one on wake), background priority, nice 10, low-priority io"""
    import plistlib
    return plistlib.dumps({
        "Label": AGENT,
        "ProgramArguments": [str(VENV_PY), str(Path(__file__).resolve()), "update"],
        "StartCalendarInterval": {"Hour": 5, "Minute": 15},
        "RunAtLoad": False, "ProcessType": "Background", "LowPriorityIO": True, "Nice": 10,
        "EnvironmentVariables": {"PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"},   # brew + uv; launchd's PATH has neither
        "StandardOutPath": str(UPDATE_LOG), "StandardErrorPath": str(UPDATE_LOG),
    }).decode()


def agents_cmd(args):
    """ytm agents install|remove|status. launchctl only for the real folder: a scratch YTM_LAUNCHAGENTS is never loaded"""
    sub = args[0] if args else "status"
    d = agents_dir(); f = d / f"{AGENT}.plist"
    real = not os.environ.get("YTM_LAUNCHAGENTS")
    dom = f"gui/{os.getuid()}"
    lc = lambda *a: subprocess.run(["launchctl", *a], capture_output=True, text=True, timeout=10)
    if sub == "install":
        d.mkdir(parents=True, exist_ok=True)
        tmp = f.with_name(f".{f.name}.{os.getpid()}"); tmp.write_text(agent_plist()); os.replace(tmp, f)
        if real: lc("bootout", f"{dom}/{AGENT}"); r = lc("bootstrap", dom, str(f))
        print(f"wrote {f}" + ("" if not real else " · loaded" if r.returncode == 0 else f" · launchctl said: {(r.stderr or r.stdout).strip()}")
              + ("" if real else " (YTM_LAUNCHAGENTS: not loaded)"))
        return None if not real or r.returncode == 0 else 1
    if sub == "remove":
        if real: lc("bootout", f"{dom}/{AGENT}")
        had = f.exists(); f.unlink(missing_ok=True)
        return print(f"removed {f}" if had else "ytm: no update agent installed")
    if sub == "status":
        loaded = real and lc("print", f"{dom}/{AGENT}").returncode == 0
        print(f"update agent  {'installed' if f.exists() else 'not installed: ytm agents install'}"
              + (" · loaded" if loaded else " · not loaded" if real and f.exists() else ""))
        print("last good update  " + (time.strftime("%b %-d %H:%M", time.localtime(STAMP.stat().st_mtime)) if STAMP.exists() else "never"))
        try: last = [l for l in UPDATE_LOG.read_text(errors="replace").splitlines() if l.startswith("== ")][-1]
        except (OSError, IndexError): last = "== nothing logged yet"
        return print(f"update.log  {last[3:]}")
    return print("usage: ytm agents install|remove|status") or 2


def _alive():
    """a player answers on the socket (connect only, no command)."""
    try:
        with socket.socket(socket.AF_UNIX) as s: s.settimeout(1); s.connect(str(SOCK)); return True
    except OSError: return False


PREMIUM_FORMAT = "774/141/251/140/234/233/bestaudio"   # signed in, 774 (opus ~257k) then 141 (aac ~258k) stream fine; the rest = the old chain


def premium_args():
    """signed in -> the account's cookie file for yt-dlp (refreshed on every player start) + the premium format chain. logged out or
    any trouble -> [] and the player stays on the anonymous hls audio, exactly as before. cookie file on disk is ok."""
    try:
        path = _lib("auth").write_cookie_file()
    except Exception:
        path = None
    if not path: return []
    return [f"--ytdl-raw-options=cookies={path}", f"--ytdl-format={PREMIUM_FORMAT}"]


def _queue_vids(ahead=5):
    """the playing song + the next few in mpv's playlist, as video ids (the cache's wish list)."""
    pl = ipc("get_property", "playlist", start=False) or []
    cur = next((i for i, e in enumerate(pl) if e.get("current") or e.get("playing")), 0)
    out = []
    for e in pl[cur:cur + 1 + ahead]:
        m = re.search(r"[?&]v=([\w-]{11})", e.get("filename", ""))
        if m: out.append(m.group(1))
    return out


_OUT = {"devs": None, "pos": None, "still": 0, "reloaded": 0.0}


def _reload_output(why):
    if time.time() - _OUT["reloaded"] < 10: return   # at most one reload per 10 s: never a loop
    _OUT["reloaded"] = time.time()
    ipc("ao-reload", start=False)
    try: (DATA / "output.log").open("a").write(f"{time.strftime('%F %T')} reload: {why}\n")
    except OSError: pass


def output_guard():
    """(bluetooth): mpv on audio-device=auto keeps the output it opened. a device that comes (headphones connect) or goes
    (they drop, the mac wakes) leaves it silent, and macOS moves the default to the speakers. so, every ~3 s, cheaply:
      - a device appeared -> ao-reload (playback follows it)
      - an external device vanished while playing -> pause (like Apple Music; never blast the speakers), then reload
      - the song is 'playing' but time-pos stood still 3 ticks (not buffering) -> ao-reload"""
    devs = ipc("get_property", "audio-device-list", start=False)
    if devs is None: return
    names = {d["name"].split("/", 1)[-1]: d.get("description", "") for d in devs if d.get("name") != "auto"}
    ext = {k for k in names if "BuiltIn" not in k}
    prev = _OUT["devs"]; _OUT["devs"] = ext
    paused = ipc("get_property", "pause", start=False)
    idle = ipc("get_property", "idle-active", start=False)
    if prev is not None and ext != prev:
        if prev - ext and paused is False and idle is False:
            ipc("set_property", "pause", True)   # the headphones left: stop, don't switch to the speakers
        _reload_output("device list changed: " + ", ".join(sorted(ext | prev)))
        _OUT["still"] = 0; return
    pos = ipc("get_property", "time-pos", start=False)
    buffering = ipc("get_property", "paused-for-cache", start=False)
    if paused is False and idle is False and not buffering and pos is not None and pos == _OUT["pos"]:
        _OUT["still"] += 1
        if _OUT["still"] >= 3: _reload_output("stalled at %.0fs" % pos); _OUT["still"] = 0
    else:
        _OUT["still"] = 0
    _OUT["pos"] = pos


def out_cmd(words):
    """ytm out: the outputs mpv sees (bluetooth, airplay, usb, hdmi, the speakers) · ytm out <number|words|auto> · ytm out reload"""
    devs = ipc("get_property", "audio-device-list") or []
    cur = ipc("get_property", "audio-device")
    ao = ipc("get_property", "current-ao") or "coreaudio"
    devs = [d for d in devs if d.get("name", "").startswith(ao + "/")]   # the active output's list: each device once
    if words == ["--json"]:   # the stage's sound card
        return print(json.dumps({"ao": ao, "current": cur, "devices": [{"n": i, "name": d.get("description") or d["name"], "on": d["name"] == cur}
                                                                      for i, d in enumerate(devs, 1)]}, ensure_ascii=False))
    if not words:
        print(f"output: {cur}" + ("  (follows the mac's default; ytm re-opens it when a device comes or goes)" if cur == "auto" else ""))
        for i, d in enumerate(devs, 1): print(f"  {i}  {d.get('description')}")
        return print("pick one: ytm out <number or words> · back to the mac's default: ytm out auto · stuck or silent: ytm out reload")
    w = " ".join(words)
    if w == "reload": ipc("ao-reload"); return print("output re-opened")
    if w == "auto": ipc("set_property", "audio-device", "auto"); return print("output: the mac's default")
    pick = devs[int(w) - 1] if w.isdigit() and 0 < int(w) <= len(devs) else next((d for d in devs if w.lower() in d.get("description", "").lower()), None)
    if not pick: return print(f"ytm: no output like '{w}': ytm out") or 1
    ipc("set_property", "audio-device", pick["name"]); print(f"output: {pick.get('description')}")


def offline_watcher():
    """ytm _offline: the background cache filler. one per player (a lock), exits when the player does."""
    O = _lib("offline")
    return O.watcher(_queue_vids, _alive, tick_fn=output_guard)


def start_offline_watcher():
    """spawn the watcher unless one already runs (a free lock = none running). never raises, never blocks."""
    try:
        import fcntl
        DATA.mkdir(parents=True, exist_ok=True)
        with (DATA / ".offline.lock").open("w") as lk:
            try: fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError: return   # one is running
        subprocess.Popen([sys.executable, __file__, "_offline"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception: pass


def play_cached(first="replace"):
    """nothing to stream (offline, youtube said no): play what is on disk, shuffled. -> how many, 0 if the cache is empty."""
    O = _lib("offline")
    vids = O.shuffled_cached()
    try: titles = json.loads(TITLES.read_text())
    except (OSError, ValueError): titles = {}
    n = 0
    for v in vids:
        row = titles.get(v) if isinstance(titles.get(v), dict) else {}
        t = {"videoId": v, "title": row.get("title"), "artists": [{"name": row["artist"]}] if row.get("artist") else []}
        load(t, first if n == 0 else "append", source="offline", keep=False); n += 1
    if n: ipc("set_property", "pause", False)
    return n


def shuffle_cmd():
    """ytm shuffle: the queue in a new order (the song playing keeps playing). mpv does the shuffling."""
    n = ipc("get_property", "playlist-count", start=False)
    if not n or n < 3: return print("ytm: nothing much to shuffle (the queue is short)") or 1
    ipc("playlist-shuffle", start=False); print(f"⤮ shuffled {n} songs")


def surprise_cmd():
    """ytm surprise: a mood you didn't pick (any of them, yours too), different from the one on now."""
    import random
    pool = [k for k in MODES if k != current_mode()]
    name = random.choice(pool)
    print(f"✦ surprise: {name}")
    return mode_cmd(name)


def daemon():
    import fcntl
    DATA.mkdir(parents=True, exist_ok=True)
    with (DATA / ".daemon.lock").open("w") as lock:  # two cold starts at once (app + tui) must not each start an mpv
        fcntl.flock(lock, fcntl.LOCK_EX)
        if SOCK.exists() and _alive(): return     # the other one won: use its player
        update()
        subprocess.Popen(["mpv", *MPV_ARGS, *premium_args()], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        for _ in range(50):
            if SOCK.exists(): time.sleep(0.1); start_offline_watcher(); return
            time.sleep(0.1)
    sys.exit("ytm: mpv didn't start (see ~/.local/share/ytm/mpv.log)")




def _lib(name):
    """lib/<name>.py on first use: `ytm p` and `ytm np` never pay for auth, spotify or the library."""
    if str(LIB) not in sys.path: sys.path.insert(0, str(LIB))
    return __import__(name)


def version():
    try: return VERSION_FILE.read_text().strip() or "?"
    except OSError: return "?"


_ACCT = None     # the logged-in client, kept once found (one keychain read, ytm's own item: no prompt)
_ANON = False    # an authed call failed: anonymous for the next 10 min (then the login gets another go), or until reset_account
_ANON_UNTIL = 0.0


def account_client():
    """the logged-in YTMusic for the account's own calls (likes, mixes, history, thumbs), or None.
    a miss isn't kept: the terminal ui lives for hours, and `ytm login` in another tab should count the next time."""
    global _ACCT
    if _ACCT is None:
        try: _ACCT = _lib("auth").client()
        except Exception: _ACCT = None
    return _ACCT


def reset_account():
    """forget what this process knew about the login (a login or logout happened elsewhere): the next call looks again."""
    global _ACCT, _ANON
    _ACCT, _ANON = None, False
    try: _lib("auth")._CLIENT = None
    except Exception: pass


def _anon():
    from ytmusicapi import YTMusic
    return YTMusic()


class _Authed:
    """the logged-in client for search and radio. google rotates cookies, so a call that raises is retried once
    anonymously, and the next 10 minutes stay anonymous: a stale login never stops the music, and one network blip doesn't
    quietly log you out for the rest of a long-running ui (login review). it says so once, on stderr."""
    def __init__(self, c): self._c = c

    def __getattr__(self, name):
        f = getattr(self._c, name)
        if not callable(f): return f
        def call(*a, **k):
            global _ANON, _ANON_UNTIL
            try: return f(*a, **k)
            except Exception as e:
                if not _ANON: print(f"ytm: the login didn't answer ({e.__class__.__name__}); anonymous for 10 min", file=sys.stderr)
                _ANON, _ANON_UNTIL = True, time.time() + 600
                return getattr(_anon(), name)(*a, **k)
        return call


def yt():
    global _ANON
    if _ANON and _ANON_UNTIL and time.time() > _ANON_UNTIL: _ANON = False
    c = None if _ANON else account_client()
    return _Authed(c) if c is not None else _anon()


# ---- shared prefs: one file the app, the terminal ui and the cli all read (DATA/prefs.json) ----
PREFS = DATA / "prefs.json"
PREF_DEFAULTS = {"v": 1, "look": "auto", "accent": "cover", "motion": "calm", "moments": True}   # an explicit look in the file stays
_CHOICES = {"look": ["auto"] + LOOKS, "accent": ACCENTS, "motion": MOTIONS}


def _prefs_raw():
    try: p = json.loads(PREFS.read_text())
    except (OSError, ValueError): return {}
    return p if isinstance(p, dict) else {}


def prefs_read():
    """-> prefs with the defaults filled in. a missing or garbled file, or a value nobody knows, reads as the default."""
    out = dict(PREF_DEFAULTS, **_prefs_raw())   # unknown keys ride along: a newer app may have written them
    for k, ok in _CHOICES.items():
        if out.get(k) not in ok: out[k] = PREF_DEFAULTS[k]
    if not isinstance(out.get("moments"), bool): out["moments"] = PREF_DEFAULTS["moments"]
    return out


def prefs_write(**kv):
    """merge kv into the file (only those keys; the rest stays as the other writers left it), atomically. -> prefs_read()."""
    for k, v in kv.items():
        if k in _CHOICES and v not in _CHOICES[k]: raise ValueError(f"{k} is one of {', '.join(_CHOICES[k])}")
        if k == "moments" and not isinstance(v, bool): raise ValueError("moments is true or false")
    p = _prefs_raw(); p.update(kv); p["v"] = 1
    DATA.mkdir(parents=True, exist_ok=True)
    tmp = PREFS.with_name(f".prefs.{os.getpid()}.tmp")   # the app may be reading: it sees the old file or the new, never half
    tmp.write_text(json.dumps(p, ensure_ascii=False)); os.replace(tmp, PREFS)
    return prefs_read()


def account():
    """-> {"ytmusic": auth.status(), "spotify": spotify.status()}. no network, only ytm's own keychain items. never raises."""
    out = {}
    for key, mod in (("ytmusic", "auth"), ("spotify", "spotify")):
        try: out[key] = _lib(mod).status()
        except Exception as e: out[key] = {"logged_in": False, "error": str(e)[:200]}
    return out


def label(t):
    artists = ", ".join(a["name"] for a in t.get("artists") or [] if a.get("name"))
    return f"{artists} – {t.get('title', '?')}" if artists else t.get("title", "?")


SEARCH_N = 3   # "only 2-3 search results, not much, not less". ten is a wall, one is no choice: everywhere a list is shown


def search(q, n=SEARCH_N, smart=False):
    """smart (the user-facing paths: play, the cards): ten hits, reranked by lib/intent.rank (query words covered, official audio,
    artists you finish; hour mixes, slowed, covers pulled down). the mode seeds and radios keep the plain order."""
    if smart:
        I = _lib("intent")
        hits = [t for t in yt().search(q, filter="songs", limit=10) if t.get("videoId")]
        try: fin = I.finished_artists(DATA)
        except Exception: fin = {}
        bad = set()
        try:
            R = _lib("ratings"); bad = R.disliked(DATA)
            for a, k in R.liked_artists(DATA).items(): fin[a] = fin.get(a, 0) + 3 * k   # a like counts for three finishes
        except Exception: pass
        return I.rank(hits, q, fin, bad)[:n]
    return [t for t in yt().search(q, filter="songs", limit=max(n, 5)) if t.get("videoId")][:n]   # limit is a hint; the slice is the cap


def intent_of(q):
    try: return _lib("intent").parse(q, list(MODES))
    except Exception: return {"kind": "plain", "q": q}


def similar_tracks(subject):
    """'songs like X': X's best match, then its radio minus that artist (one of theirs at most, else it is just their catalogue)."""
    hits = search(subject, 3, smart=True)
    if not hits: return None, []
    seed = hits[0]
    mine = {a["name"].lower() for a in seed.get("artists") or [] if a.get("name")}
    out, same = [], 0
    for t in radio_tracks(seed["videoId"]):
        if t["videoId"] == seed["videoId"]: continue
        if {a["name"].lower() for a in t.get("artists") or [] if a.get("name")} & mine:
            same += 1
            if same > 1: continue
        out.append(t)
    try: out = _lib("ratings").filter_tracks(out, DATA)
    except Exception: pass
    return seed, out


def latest_tracks(artist):
    """'X new' / 'latest from X': the artist's newest single or album (by year on their page), its tracks. -> (info, tracks)."""
    c = yt()
    arts = [r for r in c.search(artist, filter="artists", limit=3) if r.get("browseId")]
    if not arts: return None, []
    page = c.get_artist(arts[0]["browseId"])
    cands = []
    for key in ("singles", "albums"):
        for r in (page.get(key) or {}).get("results") or []:
            y = str(r.get("year") or "")
            if y.isdigit() and r.get("browseId"): cands.append((int(y), r))
    if not cands: return {"name": arts[0].get("artist") or artist}, []
    yr = max(y for y, _ in cands)
    newest = next(r for y, r in cands if y == yr)   # an artist page lists newest first within a year
    alb = c.get_album(newest["browseId"])
    tracks = [t for t in alb.get("tracks") or [] if t.get("videoId")]
    for t in tracks:
        t.setdefault("album", {"name": alb.get("title")}); t.setdefault("thumbnails", alb.get("thumbnails"))
    return {"name": arts[0].get("artist") or artist, "album": alb.get("title"), "year": yr}, tracks


def smart_play(raw):
    """read the words (lib/intent.py) before searching them. -> 0 when handled, None for a plain search (play() goes on)."""
    it = intent_of(raw); k = it["kind"]
    if k == "mode":
        name = it["mode"]
        print(f"→ {name} mode  (from \"{raw}\")")
        mode_cmd(name, refill=(name == current_mode()))   # asking again re-rolls the mode; it never toggles it off from here
        return 0
    if k == "like_now":
        vid = current_id()
        if not vid: return print("ytm: nothing is playing to be 'more like'") or 1
        ipc("playlist-clear", start=False); print(f"+{radio_from(vid)} more like this")
        return 0
    if k == "like":
        seed, tracks = similar_tracks(it["subject"])
        if not seed: return print(f"ytm: nothing for '{it['subject']}'") or 1
        if not tracks: return None
        set_mode("normal"); load(tracks[0], "replace", "like", it["subject"], seed["videoId"])
        queue(tracks[1:], "like", seed["videoId"]); ipc("set_property", "pause", False)
        print(f"▶ like {label(seed)}: {label(tracks[0])}  (+{len(tracks) - 1})")
        return 0
    if k == "new":
        info, tracks = latest_tracks(it["artist"])
        if not tracks: return None   # no dated release found: the plain search is the fallback
        set_mode("normal"); load(tracks[0], "replace", "new", it["artist"]); queue(tracks[1:], "new", tracks[0]["videoId"])
        ipc("set_property", "pause", False); radio_after(tracks[-1])
        print(f"▶ latest from {info['name']}: {info.get('album')} ({info.get('year')})  (+{len(tracks) - 1}, then its radio)")
        return 0
    return None


TITLES = DATA / "titles.json"  # video id → "artist – title", so the queue reads as songs before mpv opens them
LAST_SEARCH = DATA / "search.json"   # the last results shown, so `ytm play --vid` starts without a second lookup


def art_url(t, size=544):
    th = (t.get("thumbnails") or t.get("thumbnail") or [{}])[-1].get("url", "")  # search says thumbnails, a watch playlist (radio) thumbnail
    return __import__("re").sub(r"=w\d+-h\d+", f"=w{size}-h{size}", th) if th else ""


def secs(t):
    """a song's length in seconds: search rows say duration_seconds, a watch playlist (radio) says length "3:45" """
    if t.get("duration_seconds"): return int(t["duration_seconds"])
    try: return sum(int(x) * 60 ** i for i, x in enumerate(reversed(str(t.get("length") or t.get("duration") or "").split(":")))) or None
    except ValueError: return None


def artists(t): return ", ".join(a["name"] for a in t.get("artists") or [] if a.get("name"))


def album_name(t):
    a = t.get("album"); return (a.get("name") if isinstance(a, dict) else a) or None


def remember(*tracks):
    """titles.json gets these rows in one write (a radio is one write, not 26), whole or not at all: the stage reads it mid burst"""
    if not tracks: return
    try: m = json.loads(TITLES.read_text())
    except (OSError, ValueError): m = {}
    if not isinstance(m, dict): m = {}
    for t in tracks:
        m.pop(t["videoId"], None)  # a song heard again moves to the end, so the prune below drops the oldest heard, not the first seen
        m[t["videoId"]] = {"label": label(t), "title": t.get("title"), "artist": artists(t), "album": album_name(t), "art": art_url(t),
                           "type": t.get("videoType"), "secs": secs(t)}   # free in every row: the auto look reads an hour-long mix as one
    if len(m) > 2000: m = dict(list(m.items())[-1500:])
    DATA.mkdir(parents=True, exist_ok=True)
    tmp = TITLES.with_name(f".titles.{os.getpid()}.json")
    tmp.write_text(json.dumps(m, ensure_ascii=False)); tmp.replace(TITLES)


def card(t):
    """one search result as the app draws it. the --json contract: these six keys, always, in these types"""
    return {"videoId": t["videoId"], "title": t.get("title") or "", "artist": artists(t), "album": album_name(t) or "",
            "duration": secs(t) or 0, "art": art_url(t, 226)}


def preresolve(vids):
    """background: resolve these songs' stream urls now, so the click that plays one skips yt-dlp's 4-5 s. detached, bounded, never raises."""
    try:
        O = _lib("offline")
        todo = [v for v in vids if v and not O.local(v, touch=False) and not O.fresh_url(v)]
        if todo: subprocess.Popen([sys.executable, __file__, "_resolve", *todo[:3]], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                  stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception: pass


def search_cards(q):
    """-> ≤ SEARCH_N cards, and the rows kept in DATA/search.json for play --vid. no player, no radio. the words are read first:
    'songs like X' shows X's neighbours, 'X new' the latest release, an occasion a taste of that mode, anything else a reranked search"""
    it = intent_of(q)
    try:
        if it["kind"] == "like": hits = similar_tracks(it["subject"])[1][:SEARCH_N]
        elif it["kind"] == "new": hits = latest_tracks(it["artist"])[1][:SEARCH_N]
        elif it["kind"] == "mode":
            m = MODES[it["mode"]]; hits = search(m["seeds"][time.localtime().tm_hour % len(m["seeds"])], SEARCH_N, smart=True)
        else: hits = search(it.get("q") or q, SEARCH_N, smart=True)
    except Exception:
        if it["kind"] == "plain": raise   # offline / youtube said no: search_cmd turns it into [] and exit 1, as it always did
        hits = []                         # an intent branch failed: the plain search below is the fallback
    if not hits and it["kind"] != "plain": hits = search(q, SEARCH_N, smart=True)
    keep = ("videoId", "title", "artists", "album", "thumbnails", "thumbnail", "duration_seconds", "length", "videoType")
    try:
        DATA.mkdir(parents=True, exist_ok=True)
        tmp = LAST_SEARCH.with_name(f".search.{os.getpid()}.json")
        tmp.write_text(json.dumps({"q": q, "at": int(time.time()), "rows": [{k: t[k] for k in keep if k in t} for t in hits]}, ensure_ascii=False))
        tmp.replace(LAST_SEARCH)
    except OSError: pass
    preresolve([t["videoId"] for t in hits[:3]])
    return [card(t) for t in hits]


def search_cmd(args):
    """ytm search [--json] <words>. json: one line on stdout, nothing on stderr (the app reads both from one pipe)"""
    as_json = "--json" in args
    q = " ".join(a for a in args if a != "--json").strip()
    if not q: return print("[]" if as_json else "usage: ytm search [--json] <words>") or 2
    if as_json:
        import contextlib, io, warnings
        warnings.simplefilter("ignore")
        try:
            with contextlib.redirect_stderr(io.StringIO()): cards = search_cards(q)
        except Exception: return print("[]") or 1   # no network, youtube said no: an empty list and exit 1, never a traceback
        return print(json.dumps(cards, ensure_ascii=False))
    cards = search_cards(q)
    if not cards: return print(f"ytm: nothing for '{q}'")
    for i, c in enumerate(cards, 1):
        print(f"{i}  {c['artist'] + ' – ' if c['artist'] else ''}{c['title']}  {fmt(c['duration']) if c['duration'] else ''}".rstrip())


def load(t, mode, source="search", query=None, seed=None, keep=True):
    if keep: remember(t)   # a batch passes keep=False and remembers once
    intent = {"source": source, "query": query, "seed_vid": seed, "title": t.get("title"), "artist": artists(t) or None, "album": album_name(t)}
    ipc("set_property", f"user-data/ytm-src-{t['videoId']}", json.dumps(intent))  # ytm-log.lua reads it on file-loaded
    url = f"https://music.youtube.com/watch?v={t['videoId']}"
    # a cached or pre-resolved song opens from disk / a ready url: ytm-log.lua's on_load hook swaps it at open time (the playlist keeps
    # the watch url, so the queue reads as songs and an evicted file just streams)
    start_offline_watcher()
    # now playing (mpv --media-controls) shows media-title as the title and yt-dlp's artist tag (metadata/by-key/artist) under
    # it: "artist – title" here put the artist on screen twice more (audit). the bare title; %n% keeps commas whole
    title = t.get("title")
    return ipc("loadfile", url, mode, -1, *([f"force-media-title=%{len(title.encode())}%{title}"] if title else []))


def radio_tracks(video_id):
    tracks = [t for t in yt().get_watch_playlist(videoId=video_id, radio=True, limit=50).get("tracks", []) if t.get("videoId")]
    # the canon trap (10-26): youtube's radio slides to each genre's biggest hits. ≤30% songs already heard, ≤2 per artist.
    # the seed stays first. no account snapshot / log yet, or any trouble: youtube's order, as before
    try:
        A = _lib("account")
        if not A.snap_path().exists(): return tracks[:26]
        head, rest = tracks[:1], tracks[1:]
        return head + A.fresh_mix(rest, A.heard_vids(), n=25)
    except Exception:
        return tracks[:26]   # ytmusicapi returns ~50 whatever limit says; mpv holds metadata per entry


def queue(tracks, source, seed=None, first="append"):
    """append a batch: titles.json written once, then the loads. first="append-play" when the player sits idle"""
    try: tracks = _lib("ratings").filter_tracks(tracks, DATA)   # a disliked song is never queued again
    except Exception: pass
    remember(*tracks)
    for i, t in enumerate(tracks): load(t, first if i == 0 else "append", source, seed=seed, keep=False)
    return len(tracks)


def radio_from(video_id, skip_first=True, source="radio", first="append", ranked=False):
    tracks = radio_tracks(video_id)
    tracks = tracks[1:] if skip_first else tracks
    if ranked: tracks = taste_rank(tracks, "normal")   # a refill nobody asked for: what the log says gets finished, first
    return queue(tracks, source, video_id, first)


def taste_rank(tracks, mode):
    """lib/taste.py reorders (never drops) by what the log says gets finished in this mode at this hour; 1 in 4 stays chance.
    any trouble there and the order youtube gave stands"""
    try: ranked = _lib("taste").rank_tracks(tracks, mode, DATA)
    except Exception: ranked = list(tracks)
    try: return _lib("ratings").blend(ranked, DATA)   # a liked-artist slot in every third place
    except Exception: return ranked


RADIO_WANT = DATA / ".radio.want"   # the seed the newest play asked a radio for: an older radio still fetching steps aside


def radio_after(t):
    """the song already plays; its radio comes from a detached child, so the command (and the app waiting on it) returns
    now: the 25-song fetch cost ~2 s before (audit). YTM_RADIO_INLINE=1 (tests) does it here instead"""
    RADIO_WANT.write_text(t["videoId"])
    if os.environ.get("YTM_RADIO_INLINE"): return radio_child(t["videoId"])
    subprocess.Popen([sys.executable, __file__, "_radio", t["videoId"]], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)   # never the caller's pipe: the app reads it to the end
    return None


def radio_child(vid):
    """ytm _radio <vid>: fetch, then append only if this is still the radio wanted and that song is still the one playing.
    one at a time (a lock), capped at 60 s, no retry: a radio that fails leaves the song playing alone"""
    import fcntl, signal
    signal.alarm(60)
    tracks = radio_tracks(vid)
    with (DATA / ".radio.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try: want = RADIO_WANT.read_text().strip()
        except OSError: want = ""
        if want != vid or not SOCK.exists(): return 0   # a newer play won, or `ytm stop` came first: never start a player from here
        if not any(vid_of(e.get("filename")) == vid for e in ipc("get_property", "playlist", start=False) or []): return 0   # replaced meanwhile
        return queue([x for x in tracks if x["videoId"] != vid], "radio", vid)


def set_mode(m):
    (DATA / "mode").write_text(m); ipc("set_property", "user-data/ytm-mode", m)


def start_song(t, source, query=None):
    set_mode("normal"); load(t, "replace", source, query); ipc("set_property", "pause", False)


def play(q):
    try: handled = smart_play(q)
    except Exception as e:   # the reading of the words must never cost a play: fall back to the plain search
        try: (DATA / "intent.log").open("a").write(f"{time.strftime('%F %T')} {q!r}: {e}\n")
        except OSError: pass
        handled = None
    if handled is not None: return handled
    q = intent_of(q).get("q") or q   # 'play creep by radiohead' -> 'creep radiohead'
    hits = search(q, 1, smart=True)
    if not hits: return print(f"ytm: nothing for '{q}'")
    start_song(hits[0], "search", q)
    n = radio_after(hits[0])
    print(f"▶ {label(hits[0])}" + (f"  (+{n} in the radio)" if n is not None else "  · its radio follows"))


def play_vid(vid):
    """ytm play --vid <id>: that song (a search card), then its radio. the last search or titles.json name it; a miss asks
    youtube once, and that same answer is the radio"""
    if not VID_RE.match(vid or ""): return print("usage: ytm play --vid <11-character video id>") or 2
    t, q = None, None
    try:
        last = json.loads(LAST_SEARCH.read_text())
        t = next((r for r in last.get("rows", []) if r.get("videoId") == vid), None); q = last.get("q") if t else None
    except (OSError, ValueError, AttributeError): pass
    if t is None:
        try: row = json.loads(TITLES.read_text()).get(vid)
        except (OSError, ValueError, AttributeError): row = None
        if isinstance(row, dict) and row.get("title"):
            t = {"videoId": vid, "title": row["title"], "artists": [{"name": row["artist"]}] if row.get("artist") else [],
                 "album": row.get("album"), "thumbnails": [{"url": row["art"]}] if row.get("art") else [], "length": row.get("secs") and fmt(row["secs"])}
    if t is not None:
        start_song(t, "search", q); n = radio_after(t)
        return print(f"▶ {label(t)}" + (f"  (+{n} in the radio)" if n is not None else "  · its radio follows"))
    tracks = radio_tracks(vid)   # unknown id: one fetch names it and is its radio
    t = tracks[0] if tracks and tracks[0]["videoId"] == vid else {"videoId": vid}
    start_song(t, "search"); RADIO_WANT.write_text(vid)
    n = queue([x for x in tracks if x["videoId"] != vid], "radio", vid)
    print(f"▶ {label(t) if t.get('title') else vid}  (+{n} in the radio)")


def refill(vid):
    """ytm radio --refill <vid>: ytm-log.lua saw the queue run out after a song really ended. once per ending (the lua), one at a
    time (a lock), only while the player still sits idle; work mode refills with work, the rest with a radio from the last song"""
    import fcntl
    if not VID_RE.match(vid or ""): return 2
    with (DATA / ".refill.lock").open("w") as lock:
        try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError: return 0
        if ipc("get_property", "idle-active", start=False) is not True: return 0   # something started meanwhile: leave it
        try: mode = (DATA / "mode").read_text().strip()
        except OSError: mode = "normal"
        if mode in MODES: return mode_cmd(mode, refill=True)   # an ended queue in a mode refills with that mode
        ipc("playlist-clear", start=False)   # the songs already heard go: a player that lives for days keeps a bounded queue
        try: n = radio_from(vid, source="refill", first="append-play", ranked=True)
        except Exception: n = 0
        if not n:   # it should never stop: no radio (offline) -> the cache plays
            m = play_cached(); return print(f"offline: playing {m} cached songs" if m else "ytm: no radio and nothing cached yet")
        ipc("set_property", "pause", False)
        print(f"+{n} in the radio, from where it ended")


# work mode v0 ("chill no lyrics, just beats, lofi… takes the choosing part out of the question for me").
# seeds rotate by hour; vocal-looking tracks are dropped. 0.8.2: the queue is ranked by lib/taste.py in the work × this-hour
# context (what got finished at work around now goes first, 1 in 4 left to chance), no longer a plain shuffle.


def instrumental(t):
    s = (label(t) + " " + (t.get("album") or {}).get("name", "") if isinstance(t.get("album"), dict) else label(t)).lower()
    return not any(h in s for h in VOCAL_HINTS)


# modes: each one: what plays (seeds, lyrics or
# not, how long a track may be), how loud, and how the lights feel (see the lights add-on). `ytm mode <name>` turns one on; the same
# again turns it off (back to normal, the queue keeps playing). the seeds live in lib/modes.py; work and focus
# get melodic techno, synthwave and instrumentals as well as lofi; energy is the anthem thread.
CUSTOM_MODES = DATA / "modes.json"   # your own: ytm mode new <name> "seed, seed" [--instrumental] [--vol N] [--what words]


def _custom_modes():
    try: d = json.loads(CUSTOM_MODES.read_text())
    except (OSError, ValueError): return {}
    out = {}
    for k, m in (d.items() if isinstance(d, dict) else []):
        if MODE_NAME.match(k) and k not in MODES and isinstance(m, dict) and m.get("seeds"):
            out[k] = {"group": "mine", "seeds": [str(x) for x in m["seeds"]][:12], "instrumental": bool(m.get("instrumental")),
                      "max": int(m.get("max", 900)), "vol": max(0, min(100, int(m.get("vol", 45)))), "what": str(m.get("what") or "your own")}
    return out


MODES.update(_custom_modes())


def mode_new(words):
    """ytm mode new <name> "seed one, seed two" [--instrumental] [--vol N] [--what words]  ·  ytm mode forget <name>"""
    flags = {"instrumental": "--instrumental" in words}
    rest = [w for w in words if w != "--instrumental"]
    for f in ("--vol", "--what"):
        if f in rest:
            i = rest.index(f); flags[f[2:]] = rest[i + 1] if i + 1 < len(rest) else ""; del rest[i:i + 2]
    if len(rest) < 2: return print('usage: ytm mode new <name> "seed one, seed two" [--instrumental] [--vol N] [--what words]') or 2
    name, seeds = rest[0].lower(), [x.strip() for x in " ".join(rest[1:]).split(",") if x.strip()]
    if not MODE_NAME.match(name) or name in MODES and name not in _custom_modes():
        return print(f"ytm: '{name}' is taken or not a name (a-z, 0-9, -; 2-16 chars)") or 2
    try: d = json.loads(CUSTOM_MODES.read_text())
    except (OSError, ValueError): d = {}
    d[name] = {"seeds": seeds[:12], "instrumental": flags["instrumental"], "vol": int(flags.get("vol") or 45), "what": flags.get("what") or "your own"}
    DATA.mkdir(parents=True, exist_ok=True); CUSTOM_MODES.write_text(json.dumps(d, indent=1))
    print(f"✓ mode '{name}' · {len(seeds)} seeds · ytm mode {name}")


def mode_forget(name):
    try: d = json.loads(CUSTOM_MODES.read_text())
    except (OSError, ValueError): d = {}
    if name not in d: return print(f"ytm: no custom mode '{name}'") or 1
    d.pop(name); CUSTOM_MODES.write_text(json.dumps(d, indent=1)); print(f"forgot '{name}'")


def current_mode():
    try: return (DATA / "mode").read_text().strip() or "normal"
    except OSError: return "normal"


def mode_cmd(name, refill=False):
    """ytm mode <name>: on (or off, if it's already on) · ytm mode off · ytm mode (list)"""
    name = (name or "").strip().lower()
    if name.startswith("new "):
        try: words = __import__("shlex").split(name[4:])
        except ValueError: words = name[4:].split()   # a stray apostrophe in a seed
        return mode_new(words)
    if name.startswith("forget "): return mode_forget(name[7:].strip())
    if name == "--names": return print("\n".join(MODES))
    if name == "--json": return print(json.dumps([{"name": k, "group": m.get("group", "core"), "what": m["what"], "vol": m["vol"]} for k, m in MODES.items()], ensure_ascii=False))
    if not name:
        cur = current_mode()
        for g, title in (("core", "mood"), ("work", "working"), ("move", "doing"), ("wind", "winding down"), ("mine", "yours")):
            ms = [(k, m) for k, m in MODES.items() if m.get("group") == g]
            if not ms: continue
            print(f"{title}")
            for k, m in ms: print(f"  {'●' if k == cur else '○'} {k:9s} {m['what']}")
        return print(f"now: {cur} · ytm mode <name> toggles one · your own: ytm mode new <name> \"seed, seed\" · or just say it: ytm music for coding")
    if name in ("off", "normal") or (name == current_mode() and not refill):
        set_mode("normal"); _sleep_cancel()
        return print(f"◑ {name if name not in ('off', 'normal') else 'mode'} off · back to normal (the queue keeps playing; new radios follow the song)")
    if name not in MODES: return print(f"ytm: no mode '{name}' · {' · '.join(MODES)}") or 2
    import random
    m = MODES[name]
    seed = m["seeds"][time.localtime().tm_hour % len(m["seeds"])]
    hits = search(seed, 8)
    if not hits: return print(f"ytm: {name} seeds found nothing")
    songs = [t for t in hits if (secs(t) or 0) < m["max"] and (not m["instrumental"] or instrumental(t))] or hits   # a mode opens with a song, not an hour mix
    first = random.choice(songs[:3])
    set_mode(name)
    load(first, "replace", name, seed)   # the first song starts now; its radio is fetched after (~2 s earlier to first audio)
    ipc("set_property", "volume", int(os.environ.get(f"YTM_{name.upper()}_VOLUME", str(m["vol"]))))
    ipc("set_property", "pause", False)
    tracks = [t for t in radio_tracks(first["videoId"])   # the seed itself is dropped at queue() below
              if (not m["instrumental"] or instrumental(t)) and (secs(t) or 0) < m["max"]]   # songs, not hour-long mixes: skips teach more
    tracks = taste_rank(tracks, name)   # what got finished in this mode around this hour first, 1 in 4 left to chance
    queue([t for t in tracks if t["videoId"] != first["videoId"]], name, first["videoId"])
    _sleep_cancel()
    if m.get("timer"):   # sleep: pause after N minutes, only if still in sleep mode then (a detached child, cancelled by any mode change)
        pr = subprocess.Popen(["/bin/sh", "-c", f'sleep {m["timer"] * 60}; [ "$(cat "{DATA}/mode")" = sleep ] && "{__file__}" _pause'],
                              stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        (DATA / "sleep.pid").write_text(str(pr.pid))
    print(f"◐ {name} mode · {seed} · {len(tracks)} tracks · {m['what']}" + ("" if refill else f" · ytm mode {name} again turns it off"))


def _sleep_cancel():
    try: os.killpg(int((DATA / "sleep.pid").read_text()), 15)
    except (OSError, ValueError): pass
    (DATA / "sleep.pid").unlink(missing_ok=True)


def work(): return mode_cmd("work")


# ---- song analysis: the stage reads the whole track ahead of time, so visuals land *on* the beat and can build into a drop.
# the first version held whole songs as one frames×2048 array. an hour-long lofi mix needed ~15 GB per run,
# the stage started several, the mac swapped into a WindowServer watchdog panic. now: chunked (flat memory), capped at 12 min,
# 11 kHz, one analysis at a time machine-wide, failures parked for an hour, low priority. tested in ytm/tests/test_analyze.py.
ANALYSIS = DATA / "analysis"


def analyze(vid, quiet=False):
    """fetch ≤ 12 min of the song at 11 kHz and write analysis/<vid>.u8 + .json. one at a time, machine-wide (a lock);
    a failure parks the song for an hour; runs niced. returns the meta, or None when busy / parked / failed."""
    import fcntl
    ANALYSIS.mkdir(parents=True, exist_ok=True)
    meta_f, data_f, fail_f = ANALYSIS / f"{vid}.json", ANALYSIS / f"{vid}.u8", ANALYSIS / f"{vid}.failed"
    if meta_f.exists() and data_f.exists(): return json.loads(meta_f.read_text())
    if fail_f.exists() and time.time() - fail_f.stat().st_mtime < FAIL_HOLD: return None
    try:   # a mac already short on memory doesn't get an analysis on top (kern.memorystatus_level = % of memory free)
        free = int(subprocess.run(["sysctl", "-n", "kern.memorystatus_level"], capture_output=True, text=True, timeout=2).stdout.strip() or 100)
        if free < 20:
            if not quiet: print(f"ytm: only {free}% memory free; skipping the analysis for now")
            return None
    except (OSError, ValueError, subprocess.TimeoutExpired): pass
    lock = open(ANALYSIS / ".lock", "w")
    try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        if not quiet: print("ytm: another analysis is running; this one waits its turn")
        return None
    try:
        os.nice(15)
        url = subprocess.run(["yt-dlp", "-q", "--no-warnings", "-f", "234/233/bestaudio", "-g",
                              f"https://music.youtube.com/watch?v={vid}"], capture_output=True, text=True, timeout=60).stdout.split("\n")[0]
        if not url: raise RuntimeError("no stream url")
        pcm = subprocess.run(["ffmpeg", "-v", "error", "-t", str(MAX_SECONDS), "-i", url, "-ac", "1", "-ar", str(SR), "-f", "f32le", "-"],
                             capture_output=True, timeout=180).stdout
        import numpy as np
        out, bpm, secs = analyze_pcm(np.frombuffer(pcm, dtype=np.float32))
        data_f.write_bytes(out.tobytes())
        meta = {"v": 3, "vid": vid, "moments": moments(out), "fps": FPS, "frames": int(out.shape[0]), "width": int(out.shape[1]), "bands": BANDS,
                "bpm": round(bpm, 1), "seconds": round(secs, 1), "capped": secs >= MAX_SECONDS - 1,
                "layout": ["bands×24", "energy", "onset", "intensity", "ahead", "beat"]}
        meta_f.write_text(json.dumps(meta)); fail_f.unlink(missing_ok=True)
        for old in sorted(ANALYSIS.glob("*.u8"), key=lambda p: p.stat().st_mtime)[:-80]:
            old.unlink(); old.with_suffix(".json").unlink(missing_ok=True)
        if not quiet: print(f"◉ analysed {meta['seconds']} s · {meta['frames']} frames · ~{meta['bpm']} bpm")
        return meta
    except Exception as e:
        fail_f.write_text(str(e)[:300])
        if not quiet: print(f"ytm: analysis failed ({e}); parked for an hour")
        return None
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN); lock.close()


def show_log(n=20):
    """the last n plays, newest last (ytm v0.1). the log stays in ~/.local/share/ytm/plays, never in git."""
    files = sorted((DATA / "plays").glob("*.jsonl"))[-2:]
    rows = [json.loads(l) for f in files for l in f.read_text().splitlines() if l.strip()][-n:]
    if not rows: return print("ytm: nothing logged yet")
    mark = {"finished": "●", "partial": "◐", "skipped": "○", "stopped": "■"}
    for r in rows:
        who = f"{r.get('artist') or ''} – {r.get('title') or r.get('vid')}".strip(" –")
        print(f"{r['start'][5:16].replace('T', ' ')}  {mark.get(r['outcome'], '?')} {fmt(r.get('listened'))}/{fmt(r.get('dur'))}"
              f"  {r.get('source', ''):6} {who}")


def vid_of(url):
    """a watch url's id: v= read as a query item (not whatever follows the last "v="), 11 characters or None"""
    from urllib.parse import parse_qs, urlparse
    v = (parse_qs(urlparse(url or "").query).get("v") or [""])[0]
    return v if len(v) == 11 else None


def current_id():
    """the playing song's id, or None"""
    return vid_of(ipc("get_property", "path", start=False))


def fmt(s):
    s = int(s or 0); return f"{s // 60}:{s % 60:02d}"


# ---- the account in use: thumbs, likes, mixes, for you ----
RATED = {"LIKE": "♥ liked", "DISLIKE": "✕ disliked", "INDIFFERENT": "○ unrated"}
PLAY_CAP = 100   # mpv keeps metadata per queue entry; 100 songs is hours of music


def song_name(vid):
    try: n = json.loads(TITLES.read_text()).get(vid, vid)
    except (OSError, ValueError): n = vid
    return n.get("label", vid) if isinstance(n, dict) else n


def rate_current(rating, vid=None):
    """thumbs on the account for the song playing (or vid). -> (ok, label to show)."""
    rating = str(rating).upper()
    if rating not in RATED: return False, f"rating is one of {', '.join(RATED)}"
    vid = vid or current_id()
    if not vid: return False, "nothing playing"
    try: row = json.loads(TITLES.read_text()).get(vid) or {}
    except (OSError, ValueError): row = {}
    row = row if isinstance(row, dict) else {}
    # the local ledger first (lib/ratings.py): works signed out, never leaves the mac, shapes what plays. then the account's thumbs.
    kept = _lib("ratings").rate(vid, rating, row.get("title") or "", row.get("artist") or "", DATA)
    c = account_client()
    if c is None: return kept, f"{RATED[rating]} {song_name(vid)}" + ("  (kept on this mac; sign in to thumb it on youtube too)" if kept else "")
    if not _lib("library").rate(vid, rating, client=c): return kept, f"{RATED[rating]} {song_name(vid)}  (kept here; youtube didn't take it)"
    return True, f"{RATED[rating]} {song_name(vid)}"


def for_you(n=20):
    """songs picked from the account's home page, ranked by what the log says you finish. [] when logged out."""
    c = account_client()
    return _lib("library").recommend(n, client=c) if c is not None else []


def play_tracks(tracks, source, shuffle=False):
    """replace the queue with these (ytmusicapi-shaped) tracks and start playing. -> how many were queued."""
    import random
    tracks = [t for t in tracks or [] if isinstance(t, dict) and t.get("videoId")]
    try: tracks = _lib("ratings").filter_tracks(tracks, DATA)
    except Exception: pass
    if shuffle: tracks = random.sample(tracks, len(tracks))
    tracks = tracks[:PLAY_CAP]
    if not tracks: return 0
    set_mode("normal")
    remember(*tracks)
    load(tracks[0], "replace", source, keep=False)
    for t in tracks[1:]: load(t, "append", source, keep=False)
    ipc("set_property", "pause", False)
    return len(tracks)


def mix_tracks(m, n=50):
    """a mix (a home-page playlist) -> its tracks. the watch playlist is the mix as youtube music would play it."""
    return [t for t in (yt().get_watch_playlist(playlistId=m["playlistId"], limit=n) or {}).get("tracks", []) if t.get("videoId")][:n]


def _ago(ts):
    if not ts: return ""
    return time.strftime(" since %b %-d", time.localtime(ts))


def auth_cmd(args):
    if args[:1] not in ([], ["status"]): return print("usage: ytm auth status [--json]") or 2
    acc = account()
    if "--json" in args: return print(json.dumps(acc))
    y, s = acc["ytmusic"], acc["spotify"]
    print("youtube music  " + (f"logged in as {y.get('account') or '?'} (from {y.get('source') or '?'}{_ago(y.get('saved_at'))})"
                               if y.get("logged_in") else "not logged in: ytm login"))
    print("spotify        " + ("linked" if s.get("logged_in") else
                               "not linked: ytm spotify login" if s.get("client_id") else "not set up: ytm spotify client-id <id>"))


def login_cmd(src):
    """ytm login → pick an account from a list (terminal) · ytm login --list [--json] (the app's chooser) ·
    ytm login <browser:Profile N>[#k] (k = the k-th google account signed in to that profile) · ytm login auto"""
    A = _lib("auth")
    words = src.split()
    if "--list" in words:
        ps = A.profiles()
        if "--json" in words: return print(json.dumps(ps, ensure_ascii=False))
        for i, p in enumerate(ps, 1):
            print(f"{i:2d}  {'●' if p['signed_in'] else '○'} {p['name']}  ({p['browser']}{' · ' + ', '.join(p['accounts']) if p['accounts'] else ''})")
        return
    if src == "choose":
        ps = [p for p in A.profiles() if p["signed_in"]]
        if not ps:   # nothing signed in anywhere: send them to the browser, then come back
            subprocess.run(["open", "https://music.youtube.com"])
            return print("no browser is signed in to youtube music yet. it's open in your browser now: sign in with the account you want,\n"
                         "then run ytm login again.") or 1
        print("which account? (● = signed in to youtube there)")
        for i, p in enumerate(ps, 1):
            print(f"  {i}. {p['name']}  ({p['browser']}{' · ' + ', '.join(p['accounts']) if p['accounts'] else ''})")
        print(f"  {len(ps) + 1}. a different account: open youtube music in the browser to sign in")
        try: pick = int(input("number: ").strip() or "0")
        except (ValueError, EOFError): return print("ytm: no account picked") or 1
        if pick == len(ps) + 1:
            subprocess.run(["open", "https://music.youtube.com"]); return print("sign in there, then run ytm login again.")
        if not 1 <= pick <= len(ps): return print("ytm: no account picked") or 1
        src = ps[pick - 1]["source"]
    name = src.partition(":")[0].lower()
    if name in ("auto", "vivaldi", "chrome", "brave", "app"):
        print("macOS may ask for the browser's \"Safe Storage\" key: type the mac password, then press Allow, not Always Allow\n"
              "(always would let any program running as you read every cookie and saved password in that browser, silently).", file=sys.stderr)
    try: st = A.login(src)
    except A.AuthError as e: return print(f"ytm: {e}") or 1
    reset_account()
    print(f"logged in as {st.get('account') or '?'} (from {st.get('source')})")
    if "#" not in src and src != "app":
        print(f"not the right account? ytm logout, then ytm login '{src}#1' for the second google account signed in there")


def look_cmd(args):
    """ytm look · ytm look <name|auto> · ytm look accent <a> · ytm look motion <m> · ytm look moments on|off"""
    by_label = {v.replace(" ", ""): k for k, v in LOOK_NAMES.items()}
    try:
        if not args: p = prefs_read()
        elif args[0] in ("accent", "motion") and len(args) == 2: p = prefs_write(**{args[0]: args[1].lower()})
        elif args[0] == "moments" and len(args) == 2 and args[1] in ("on", "off"): p = prefs_write(moments=args[1] == "on")
        else:
            name = "".join(args).lower()
            p = prefs_write(look=by_label.get(name, name))
    except ValueError as e:
        print(f"ytm: {e} (a song called that? ytm play look {' '.join(args)})"); return 2
    work = (DATA / "mode").exists() and (DATA / "mode").read_text().strip() == "work"
    shown = LOOK_NAMES[p["look"]]
    if p["look"] == "auto":   # which look the playing song got, and why: the app's cached pick, else worked out from disk
        vid = current_id()
        try: a = _lib("autolook").for_song(DATA, vid) if vid else None
        except Exception: a = None
        if a: why = a["reason"].split(" · ", 1); shown = f"auto · {LOOK_NAMES[a['look']]}" + (f" ({' · '.join(why[1:])})" if why[1:] else "")
    print(f"look {shown} · accent {p['accent']} · motion {p['motion']} · moments {'on' if p['moments'] else 'off'}"
          + ("  (work mode: paper while the look is auto; pick one to override)" if work and p["look"] == "auto" else ""))
    if not args: print(f"  looks: auto · {' · '.join(LOOKS)}   accents: {' · '.join(ACCENTS)}   motion: {' · '.join(MOTIONS)}")


def account_cmd(cmd, args):
    """the commands that talk to the account. -> exit code (None = 0)."""
    if cmd in ("like", "dislike", "unrate"):
        ok, msg = rate_current({"like": "LIKE", "dislike": "DISLIKE", "unrate": "INDIFFERENT"}[cmd], args[0] if args else None)
        print(msg if ok else f"ytm: {msg}")
        if ok and cmd == "dislike" and not args: ipc("playlist-next", "force", start=False)  # as youtube music does
        return None if ok else 1
    if cmd == "rated":   # the local ledger: ytm rated [liked|disliked] [--json | --play]
        R = _lib("ratings"); kind = "DISLIKE" if (args[:1] or ["liked"])[0].startswith("dis") else "LIKE"
        if "--json" in args:
            return print(json.dumps({"summary": R.summary(DATA), "liked": R.recent("LIKE", 40, DATA), "disliked": R.recent("DISLIKE", 40, DATA)}, ensure_ascii=False))
        rows = R.recent(kind, 200, DATA)
        if "--play" in args:
            n = play_tracks([{"videoId": r["vid"], "title": r["title"], "artists": [{"name": r["artist"]}] if r["artist"] else []} for r in rows], "liked", shuffle=True)
            return print(f"▶ {n} of your liked songs" if n else "ytm: nothing liked yet: ytm like (or the heart in the app)") or (0 if n else 1)
        sm = R.summary(DATA); print(f"♥ {sm['liked']} liked · ✕ {sm['disliked']} disliked")
        for r in rows[:20]: print(f"  {r['artist'] + ' – ' if r['artist'] else ''}{r['title'] or r['vid']}")
        return None
    if account_client() is None: return print("ytm: not logged in: ytm login") or 1
    L = _lib("library")
    if cmd == "likes":
        n = play_tracks(L.liked(200, client=account_client()), "likes", shuffle=True)
        return print(f"♥ {n} liked songs, shuffled" if n else "ytm: no liked songs (or youtube didn't answer)")
    if cmd == "for-you":
        n = play_tracks(for_you(), "for-you")
        return print(f"✦ {n} for you" if n else "ytm: nothing to pick from yet")
    mx = L.mixes(client=account_client())
    if cmd == "mixes":
        if not mx: return print("ytm: no mixes on your home page")
        for i, m in enumerate(mx, 1): print(f"{i:2d}  {m.get('title') or m['playlistId']}  · {m.get('row') or ''}".rstrip(" ·"))
        return None
    if cmd == "mix":
        i = int(args[0]) if args and args[0].isdigit() else 1
        if not 1 <= i <= len(mx): return print(f"ytm: no mix {i} ({len(mx)} on your home page: ytm mixes)") or 1
        n = play_tracks(mix_tracks(mx[i - 1]), "mix")
        return print(f"▶ {mx[i - 1].get('title')} · {n} songs" if n else "ytm: that mix came back empty")
    if cmd == "history":
        if "--backfill" in args:
            r = L.backfill_log(client=account_client())
            return print(f"+{r['added']} plays into the log · {r['skipped']} already there · {r['unparsed']} undated")
        rows = L.history(20, client=account_client())
        for t in reversed(rows): print(f"{(t.get('played') or ''):11.11} {label(t)}")
        return None if rows else print("ytm: no history on the account")


VID_RE = __import__("re").compile(r"^[\w-]{11}$")


def main(a):
    if a[:2] == ["play", "--vid"]: return play_vid(a[2] if a[2:] else "")
    if a[:1] in (["play"], ["--"]): return play(" ".join(a[1:])) if a[1:] else print("usage: ytm play <words>") or 2
    if a[:1] in (["like"], ["dislike"]) and (len(a) > 2 or len(a) == 2 and not VID_RE.match(a[1])):
        return play(" ".join(a))   # "ytm like a rolling stone" is a song, not a thumbs up for video "a"
    cmd, rest = (a[0], " ".join(a[1:])) if a else ("np", "")
    if cmd in ("p", "pause"):
        ipc("cycle", "pause", start=False); print("⏸" if ipc("get_property", "pause", start=False) else "▶")
    elif cmd in ("n", "next"): ipc("playlist-next", "force", start=False)
    elif cmd in ("b", "back", "prev"): ipc("playlist-prev", "force", start=False)
    elif cmd == "np":
        t = ipc("get_property", "media-title", start=False)
        if not t: return print("ytm: nothing playing")
        vid = current_id(); t = song_name(vid) if vid and song_name(vid) != vid else t   # media-title is the bare title now
        pos, dur = ipc("get_property", "time-pos", start=False), ipc("get_property", "duration", start=False)
        print(f"{'⏸' if ipc('get_property', 'pause', start=False) else '▶'} {t}  {fmt(pos)}/{fmt(dur)}")
    elif cmd in ("q", "queue"):
        pl = ipc("get_property", "playlist", start=False) or []
        try: names = json.loads(TITLES.read_text())
        except (OSError, ValueError): names = {}
        for i, e in enumerate(pl):
            mark = "▶" if e.get("current") else " "
            vid = vid_of(e.get("filename")) or e.get("filename", "")   # the same parse as current_id (a later v= gave a wrong id)
            n = names.get(vid, vid); n = n.get("label", vid) if isinstance(n, dict) else n
            print(f"{mark} {i:2d}  {n if n != vid else e.get('title') or n}")   # the label: media-title is the bare title now
    elif cmd == "vol": ipc("set_property", "volume", max(0, min(100, int(rest or 60))), start=False)
    elif cmd == "seek": ipc("seek", float(rest or 10), "relative", start=False)
    elif cmd == "add":
        hits = search(rest, 1)
        if hits: load(hits[0], "insert-next", "add", rest); print(f"+ {label(hits[0])}")
    elif cmd == "pick":
        hits = search(rest)
        if not hits: return print(f"ytm: nothing for '{rest}'")
        lines = "\n".join(f"{i}\t{label(t)}" for i, t in enumerate(hits))
        r = subprocess.run(["fzf", "--with-nth=2", "--delimiter=\t", f"--height={SEARCH_N + 3}", "--reverse", "--prompt=ytm › "],
                           input=lines, stdout=subprocess.PIPE, text=True)   # fzf draws on the tty itself: only stdout is ours
        if r.returncode == 0 and r.stdout.strip():
            t = hits[int(r.stdout.split("\t")[0])]
            start_song(t, "pick", rest); n = radio_after(t)
            print(f"▶ {label(t)}" + (f"  (+{n} in the radio)" if n is not None else "  · its radio follows"))
    elif cmd == "radio" and a[1:2] == ["--refill"]: return refill(a[2] if a[2:] else "")
    elif cmd == "radio":
        vid = current_id()
        if not vid: return print("ytm: nothing playing to seed a radio")
        ipc("playlist-clear", start=False); print(f"+{radio_from(vid)} in the radio")
    elif cmd == "shuffle": return shuffle_cmd()
    elif cmd == "surprise": return surprise_cmd()
    elif cmd == "_offline": return offline_watcher()
    elif cmd == "_resolve": _lib("offline").resolve_many(a[1:]); return 0
    elif cmd == "out": return out_cmd(rest.split())
    elif cmd == "cache":   # the offline cache: status (default) · play · fill (watcher runs on its own) · clear
        O = _lib("offline"); sub = (rest.split() or ["status"])[0]
        if sub == "play": n = play_cached(); return print(f"▶ {n} cached songs" if n else "ytm: nothing cached yet") or (0 if n else 1)
        if sub == "clear": return print(f"cleared {O.clear()} files")
        if sub == "--json": st = O.status(); return print(json.dumps({"files": st["files"], "mb": round(st["bytes"] / 1048576), "cap_mb": st["cap"] // 1048576}))
        st = O.status(); print(f"cache  {st['files']} songs · {st['bytes'] / 1048576:.0f} MB of {st['cap'] // 1048576} MB · {st['dir']}")
        return print("ytm cache play · ytm cache clear · it fills itself while the player runs (the queue first, then your most-finished)")
    elif cmd == "stop":
        ipc("quit", start=False); SOCK.unlink(missing_ok=True); print("■")
    elif cmd == "work": return mode_cmd("work")
    elif cmd == "mode": return mode_cmd(rest)
    elif cmd == "_pause": ipc("set_property", "pause", True, start=False); set_mode("normal")
    elif cmd == "update":
        if "--auto" in a: return update_child()
        return update(broken=True) if "--broken" in a else update(now=True)
    elif cmd == "agents": return agents_cmd(a[1:])
    elif cmd == "search": return search_cmd(a[1:])
    elif cmd == "taste": return _lib("taste").main(a[1:], DATA)
    elif cmd == "_radio": return radio_child(a[1]) if a[1:] else 2
    elif cmd == "analyze": analyze(rest.strip() or current_id())
    elif cmd == "stage":   # the native stage (stage/): builds itself the first time
        app = HOME / "Applications/ytm.app"
        if rest.strip() == "build" or not app.exists(): subprocess.run([str(ROOT / "stage/build.sh")])
        subprocess.run(["open", str(app)])
    elif cmd == "log": show_log(int(rest.split()[-1]) if rest.strip().lstrip("-n ").isdigit() else 20)
    elif cmd == "ui":  # the clickable remote (textual, tui.py); music keeps playing when it closes
        sys.path.insert(0, str(ROOT)); import tui; tui.run()
    elif cmd in ("-h", "--help", "help"): print(__doc__)
    elif cmd in ("--version", "version", "-V"): print(f"ytm {version()}")
    elif cmd in ("playlists", "pl", "explore", "takeout"):   # your own playlists one tap away · the anti-saturation explorer · the whole history
        A = _lib("account")
        snap = json.loads(A.snap_path().read_text()) if A.snap_path().exists() else {}
        words = rest.split()
        if cmd == "playlists":
            pls = [p for p in snap.get("playlists") or [] if p.get("id")]
            if not pls: return print("ytm: no playlists yet: ytm sync") or 1
            if "--json" in words: return print(json.dumps([{"n": i, "title": p.get("title"), "count": A._n(p.get("count")), "id": p["id"]} for i, p in enumerate(pls, 1)], ensure_ascii=False))
            for i, p in enumerate(pls, 1): print(f"{i:3d}  {p.get('title')}" + (f"  · {p.get('count')}" if p.get("count") else ""))
            return print("play one: ytm pl <number or words>")
        c = account_client()
        if c is None: return print("ytm: log in first (ytm login)") or 1
        if cmd == "pl":
            pid = words[1] if words[:1] == ["--id"] and len(words) > 1 else None
            pl = {"id": pid, "title": pid} if pid else A.find_playlist(snap, words)
            if not pl: return print(f"ytm: no playlist like '{rest}' (ytm playlists)") or 1
            tracks = A.playlist_tracks(c, pl["id"])   # fresh from youtube: the playlist may have grown since the sync
            n = play_tracks(tracks, "playlist", shuffle=True)
            return print(f"▶ {pl.get('title')}  ({n} shuffled)" if n else f"ytm: '{pl.get('title')}' came back empty")
        if cmd == "explore":
            rows = []
            for f in sorted((DATA / "plays").glob("*.jsonl"))[-3:]:
                rows += [json.loads(l) for l in f.read_text().splitlines() if l.strip()]
            n = int(words[0]) if words and words[0].isdigit() else 12
            picks, pools = A.explore_pick(snap, rows, min(40, int(n * 1.5)))
            print(f"exploring · {pools['forgotten_pool']} forgotten in your library · {pools['neighbour_pool']} neighbours of your artists you've never played"
                  f" · {pools['never_pool']} wild cards" + ("" if snap.get("related") else "  (run ytm sync once for the neighbours)"))
            tracks = A.explore_tracks(c, picks, want=n)
            mark = {"forgotten": "↺", "a neighbour": "◇", "wild card": "✦"}
            for t in tracks: print(f"  {mark.get(t['_why'], '·')} {label(t)}")
            k = play_tracks(tracks, "explore")
            return print(f"▶ {k} songs · ↺ forgotten  ◇ a neighbour  ✦ a wild card · finish what you like: it learns, fast skips rest 60 days")
        if cmd == "takeout":
            if not words: return print("ytm takeout <path to watch-history.json>  (takeout.google.com → YouTube and YouTube Music → history, JSON)") or 1
            rows = A.takeout_rows(words[0])
            summ = A.takeout_summary(rows)
            (DATA / "account").mkdir(parents=True, exist_ok=True)
            (DATA / "account" / "takeout.json").write_text(json.dumps({"rows": rows, "summary": summ}, ensure_ascii=False))
            print(f"{summ['plays']} youtube music plays · {summ['first']} → {summ['last']} · {summ['artists_ever']} artists ever ({summ['one_play_artists']} heard once)")
            for y, v in summ["years"].items(): print(f"  {y}  {v['plays']:5d} plays · {v['artists']:4d} artists · " + ", ".join(v["top"][:5]))
            return
    elif cmd in ("sync", "insights"):   # the account, pulled into a local snapshot, read as insights (lib/account.py)
        A = _lib("account")
        if cmd == "sync" or not A.snap_path().exists():
            c = account_client()
            if c is None: return print("ytm: log in first (ytm login)") or 1
            print("pulling the account into ~/.local/share/ytm/account (stays on this mac)…"); A.pull(c)
        snap = json.loads(A.snap_path().read_text())
        rows = []
        for f in sorted((DATA / "plays").glob("*.jsonl"))[-3:]:
            rows += [json.loads(l) for l in f.read_text().splitlines() if l.strip()]
        ins = A.insights(snap, rows)
        (DATA / "account" / "insights.json").write_text(json.dumps(ins, ensure_ascii=False, indent=1))
        if "--json" in rest.split(): return print(json.dumps(ins, ensure_ascii=False))
        sz = ins["size"]; print(f"\nyou · {ins['account']} · " + " · ".join(f"{v} {k}" for k, v in sz.items() if v))
        print("top artists   " + " · ".join(t["artist"] for t in ins["top_artists"][:10]))
        if ins["core"]: print("your core     " + " · ".join(ins["core"][:8]) + "  (in 3+ places: liked, library, history, subscribed, played here)")
        print("languages     " + " · ".join(f"{l['script']} {round(100 * l['share'])}%" for l in ins["languages"][:4]))
        print("formats       " + " · ".join(f"{f['kind']} {round(100 * f['share'])}%" for f in ins["formats"][:3]))
        print(f"recent        {round(100 * ins['mix_share_recent'])}% long mixes / study-sleep sets · {round(100 * ins['loyalty'])}% of plays are artists you liked or follow")
        if ins["on_repeat"]: print("on repeat     " + " · ".join(f"{r['title']} ×{r['times']}" for r in ins["on_repeat"][:4]))
        if ins["played_not_liked"]: print("played, never liked  " + " · ".join(ins["played_not_liked"][:6]))
        if ins["failed"]: print("(skipped: " + ", ".join(ins["failed"]) + ")")
    elif cmd == "login" and "--list" in a: return print(json.dumps(_lib("auth").profiles(), ensure_ascii=False))   # the app's chooser: names only, no cookies read
    elif cmd == "login": return login_cmd(rest.strip() or ("choose" if sys.stdin.isatty() else "auto"))
    elif cmd == "logout": print("logged out of youtube music" if _lib("auth").logout() else "wasn't logged in")
    elif cmd == "auth": return auth_cmd(a[1:])
    elif cmd == "spotify": return _lib("spotify").main(a[1:])
    elif cmd in ("like", "dislike", "unrate", "rated", "likes", "mixes", "mix", "for-you", "history"): return account_cmd(cmd, a[1:])
    elif cmd == "look": return look_cmd(a[1:])
    elif cmd == "prefs": print(json.dumps(prefs_read()) if "--json" in a else
                               "  ".join(f"{k} {v}" for k, v in prefs_read().items() if k != "v"))
    else:
        play(" ".join(a))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
